APP_NAME=HEALTHSYNC-AI API
ENVIRONMENT=development
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://healthsync_user:healthsync_dev_password@localhost:5433/healthsync
JWT_SECRET=local-development-secret-change-this-before-deployment-123456
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=./storage/medical_records
MAX_UPLOAD_MB=10
# Tesseract word-confidence threshold (0-100) before automatic hosted OCR escalation on low-quality pages.
OCR_ESCALATION_MIN_CONFIDENCE=65
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_DELIVERY=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=

# Hugging Face is primary. OpenRouter is an optional provider fallback.
OPENROUTER_API_KEY=
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_CHAT_MODEL_ID=openai/gpt-4o-mini
OPENROUTER_SUMMARY_MODEL_ID=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL_ID=google/gemini-2.5-flash

# Token with Hugging Face Inference Providers access; keep private and backend-only.
HF_TOKEN=
HF_MODEL_ID=Qwen/Qwen3-4B:fastest
HF_VISION_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct:fastest
# Optional local fine-tuned Qwen3 adapter; leave empty to use deterministic local extraction.
LOCAL_QWEN_BASE_MODEL_ID=Qwen/Qwen3-4B
LOCAL_QWEN_ADAPTER_DIR=
LOCAL_QWEN_MAX_NEW_TOKENS=700
HF_CHAT_ENDPOINT=https://router.huggingface.co/v1/chat/completions
